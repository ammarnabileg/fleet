APP_ENV=production
APP_IMAGE=registry.brillianttech.example/fleet-backend:0.1.0
SECRET_KEY=CHANGE_ME

# least-privilege app user; the owner role is for migrations only
DATABASE_URL=postgresql+psycopg://fleet_app:CHANGE_ME@postgres:5432/fleet
MIGRATIONS_DATABASE_URL=postgresql+psycopg://fleet_owner:CHANGE_ME@postgres:5432/fleet
POSTGRES_PASSWORD=CHANGE_ME

REDIS_PASSWORD=CHANGE_ME
CELERY_BROKER_URL=redis://:CHANGE_ME@redis-queue:6379/0
RATE_LIMIT_REDIS_URL=redis://:CHANGE_ME@redis-queue:6379/1
CACHE_REDIS_URL=redis://:CHANGE_ME@redis-cache:6379/0
LIVE_BROKER=redis

FILES_DIR=/data/files
MAX_UPLOAD_MB=10

# the address drivers open: activation links point to <PUBLIC_URL>/activate
PUBLIC_URL=https://fleet.brillianttech.example

# driver sign-in codes and activation links over WhatsApp (Evolution API v2); use a dedicated number, not a personal one
MESSAGING_PROVIDER=whatsapp
EVOLUTION_API_URL=https://evolution.brillianttech.example
EVOLUTION_API_KEY=CHANGE_ME
EVOLUTION_INSTANCE=CHANGE_ME
FCM_CREDENTIALS_FILE=/run/secrets/fcm.json
MAPS_API_KEY=CHANGE_ME
SENTRY_DSN=

HR_INTEGRATION_MODE=off

PGBACKREST_REPO1_S3_KEY=CHANGE_ME
PGBACKREST_REPO1_S3_KEY_SECRET=CHANGE_ME
PGBACKREST_REPO1_CIPHER_PASS=CHANGE_ME
RESTIC_REPOSITORY=s3:https://backup.brillianttech.example/fleet-files
RESTIC_PASSWORD=CHANGE_ME
