# Coolify: enter these on the resource's Environment Variables screen (they are listed there from the compose file).
# By hand: copy to .env at the repository's root, next to docker-compose.yml. Passwords sit inside URLs: letters and digits only, e.g. `openssl rand -hex 24`.

# ---- required
# openssl rand -hex 32; also encrypts the keys entered in the panel (R2, WhatsApp): keep it
SECRET_KEY=
# the database owner (migrations only)
POSTGRES_PASSWORD=
# the application's least-privilege login, created on the database's first start
FLEET_APP_DB_PASSWORD=
REDIS_PASSWORD=
# https://<the domain>: activation links point to <PUBLIC_URL>/activate
PUBLIC_URL=

# ---- server size (defaults suit a server of about 8 GB; on 16 GB: 4GB / 10GB / 8g)
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_MEMORY_LIMIT=4g
API_WORKERS=4

# ---- WhatsApp (Evolution API v2): "panel" = entered in the control panel (Integrations), stored encrypted
MESSAGING_PROVIDER=panel
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# ---- request limits per client address; on the day drivers sign up together at the office, list its address here
RATE_SIGN_IN_PER_15MIN=60
RATE_OTP_SEND_PER_HOUR=30
RATE_OTP_CHECK_PER_15MIN=60
RATE_UPLOADS_PER_HOUR=600
RATE_LIMIT_EXEMPT=

MAX_UPLOAD_MB=10
# a folder on the server outside the deployed code (maps/update-map.sh)
MAPS_DIR=/srv/fleet-maps
SENTRY_DSN=
HR_INTEGRATION_MODE=off

# ---- backups (backup-and-restore.sh). Until the bucket is set the database keeps no WAL archive: no point-in-time
# restore. Once set, also set PG_ARCHIVE_COMMAND, redeploy, then run stanza-create once.
PGBACKREST_REPO1_S3_ENDPOINT=
PGBACKREST_REPO1_S3_BUCKET=
PGBACKREST_REPO1_S3_REGION=us-east-1
PGBACKREST_REPO1_PATH=/fleet
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
PGBACKREST_REPO1_CIPHER_PASS=
# pgbackrest --stanza=fleet archive-push %p
PG_ARCHIVE_COMMAND=
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
